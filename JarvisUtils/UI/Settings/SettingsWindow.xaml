<Window x:Class="JarvisUtils.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JarvisUtils — настройки"
        Width="900" Height="600" MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#FF14161D" Foreground="#FFE8EAEE" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JarvisUtils;component/UI/Theme/JarvisStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FF171922" BorderBrush="#FF232733" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,12">
                <TextBlock DockPanel.Dock="Top" Text="JARVIS UTILS"
                           Foreground="{StaticResource Accent}" FontSize="11"
                           FontWeight="SemiBold" Margin="22,0,0,14"/>
                <ListBox x:Name="ModulesList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorHost" Margin="28,24,28,24" MaxWidth="720" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</Window>