<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>WinExe</OutputType>
        <Version>1.0.0</Version>
        <ApplicationIcon>App\JarvisUtils.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
      <Resource Include="App\JarvisUtils.ico" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
      <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>

</Project>
